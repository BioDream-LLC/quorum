# Build trees -- everything here is regenerated by cmake and the tools.
build/
*/build/
solver/build/
out/
cmake-build-*/

# Compiled objects, libraries, binaries
*.o
*.a
*.so
*.elf
*.bin
*.hex
*.map
*.uf2
*.d

# Generated headers are NOT tracked: they only exist under build/ and are
# reproducible from the .cb sources, which ARE tracked. pump.cb in particular is
# frozen as the fixed point of the equivalence proof against the hand-written
# pump_casebook.hpp, so the input is the artifact worth preserving, not the output.

# Staged firmware trees are reproducible from stage-portable.sh
build/arduino-portable/

# Editor / OS noise
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Scratch
/tmp/
*.log
core

# Credentials -- nothing of this kind should ever exist here, listed so that an
# accident does not become a commit.
.env
.env.*
*.pem
*.key
id_rsa*
*credentials*

# Python bytecode
__pycache__/
*.pyc

# Code-signing material (studio/build.sh SIGN_PFX): never committed
*.pfx
*.p12
presentations/quorum_Public.pptx
